if(NOT DEFINED MANIFEST OR NOT DEFINED BASE_DIR)
    message(FATAL_ERROR "MANIFEST and BASE_DIR are required")
endif()

file(STRINGS "${MANIFEST}" manifest_lines)
set(checked 0)
foreach(line IN LISTS manifest_lines)
    if(line MATCHES "^#" OR line STREQUAL "")
        continue()
    endif()
    if(NOT line MATCHES "^([0-9a-f]+)  (.+)$")
        message(FATAL_ERROR "malformed SHA-256 manifest line: ${line}")
    endif()
    set(expected "${CMAKE_MATCH_1}")
    set(relative_path "${CMAKE_MATCH_2}")
    string(LENGTH "${expected}" digest_length)
    if(NOT digest_length EQUAL 64)
        message(FATAL_ERROR "malformed SHA-256 digest for ${relative_path}")
    endif()
    if(NOT EXISTS "${BASE_DIR}/${relative_path}")
        message(FATAL_ERROR "manifest file is missing: ${relative_path}")
    endif()
    file(SHA256 "${BASE_DIR}/${relative_path}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "SHA-256 mismatch for ${relative_path}: expected ${expected}, got ${actual}")
    endif()
    math(EXPR checked "${checked} + 1")
endforeach()

if(checked EQUAL 0)
    message(FATAL_ERROR "SHA-256 manifest contained no files")
endif()
if(DEFINED EXPECTED_COUNT AND NOT checked EQUAL EXPECTED_COUNT)
    message(FATAL_ERROR
        "SHA-256 manifest contained ${checked} files; expected ${EXPECTED_COUNT}")
endif()
message(STATUS "Verified ${checked} files from ${MANIFEST}")
