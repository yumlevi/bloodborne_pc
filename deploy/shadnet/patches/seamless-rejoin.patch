diff --git a/tests/test_bloodborne_summon_broker.cpp b/tests/test_bloodborne_summon_broker.cpp
index 096947d..d84378e 100644
--- a/tests/test_bloodborne_summon_broker.cpp
+++ b/tests/test_bloodborne_summon_broker.cpp
@@ -206,6 +206,48 @@ int main() {
   CHECK(seamless.StateFor(QStringLiteral("guest-session"), 2465, 6'020) ==
         Bloodborne::SummonBroker::State::Consumed);
 
+  // A game that keeps posting its sign must not refresh an old claim forever.
+  Bloodborne::SummonBroker::Options rejoinOptions = seamlessOptions;
+  rejoinOptions.seamlessClaimLeaseMs = 100;
+  Bloodborne::SummonBroker rejoin(rejoinOptions);
+  CHECK(rejoin.Advertise(Parse(advertisement), advertisement, 10'000).state ==
+        Bloodborne::SummonBroker::State::Advertised);
+  CHECK(rejoin.Claim(Parse(claim), claim, 10'010).status ==
+        Bloodborne::SummonBroker::ClaimStatus::Claimed);
+  const auto stillJoining =
+      rejoin.Advertise(Parse(advertisement), advertisement, 10'050);
+  CHECK(stillJoining.state == Bloodborne::SummonBroker::State::Delivered);
+  CHECK(stillJoining.pendingClaim == claim);
+  CHECK(!stillJoining.expiredClaimReset);
+  const auto freshSign =
+      rejoin.Advertise(Parse(advertisement), advertisement, 10'110);
+  CHECK(freshSign.state == Bloodborne::SummonBroker::State::Advertised);
+  CHECK(freshSign.pendingClaim.isEmpty());
+  CHECK(freshSign.expiredClaimReset);
+  CHECK(rejoin.Search(Parse(unrelatedSearch), 10'111).size() == 1);
+  CHECK(rejoin.Claim(Parse(conflictingClaim), conflictingClaim, 10'112).status ==
+        Bloodborne::SummonBroker::ClaimStatus::Claimed);
+  const QByteArray wrongSessionRemoval =
+      R"({"MessageId":"SummonDataRemoveRequest","SessionId":"other-session","UserId":2465,"Force":true})";
+  CHECK(rejoin.Consume(Parse(wrongSessionRemoval), 10'113).consumed == 0);
+  CHECK(rejoin.StateFor(QStringLiteral("guest-session"), 2465, 10'113) ==
+        Bloodborne::SummonBroker::State::Claimed);
+
+  // The lease is intentionally ignored by the traditional server.
+  Bloodborne::SummonBroker::Options classicLeaseOptions = rejoinOptions;
+  classicLeaseOptions.seamlessCoop = false;
+  classicLeaseOptions.seamlessAnywhereSummons = false;
+  Bloodborne::SummonBroker classicLease(classicLeaseOptions);
+  CHECK(classicLease.Advertise(Parse(advertisement), advertisement, 20'000).state ==
+        Bloodborne::SummonBroker::State::Advertised);
+  CHECK(classicLease.Claim(Parse(claim), claim, 20'010).status ==
+        Bloodborne::SummonBroker::ClaimStatus::Claimed);
+  const auto classicRedelivery =
+      classicLease.Advertise(Parse(advertisement), advertisement, 20'110);
+  CHECK(classicRedelivery.state == Bloodborne::SummonBroker::State::Delivered);
+  CHECK(classicRedelivery.pendingClaim == claim);
+  CHECK(!classicRedelivery.expiredClaimReset);
+
   Bloodborne::SummonBroker unclaimedSeamless(seamlessOptions);
   CHECK(unclaimedSeamless.Advertise(Parse(advertisement), advertisement, 7'000)
             .state == Bloodborne::SummonBroker::State::Advertised);
