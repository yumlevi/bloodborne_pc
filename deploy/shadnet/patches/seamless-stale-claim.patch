diff --git a/tests/test_bloodborne_summon_broker.cpp b/tests/test_bloodborne_summon_broker.cpp
--- a/tests/test_bloodborne_summon_broker.cpp
+++ b/tests/test_bloodborne_summon_broker.cpp
@@ -233,3 +233,37 @@ int main() {
+  // A guest that stops posting signs after a claim must not remain searchable
+  // by its old host for the full 15-minute seamless retention window.
+  Bloodborne::SummonBroker staleWithoutCreate(rejoinOptions);
+  CHECK(staleWithoutCreate.Advertise(Parse(advertisement), advertisement, 30'000).state ==
+        Bloodborne::SummonBroker::State::Advertised);
+  CHECK(staleWithoutCreate.Claim(Parse(claim), claim, 30'010).status ==
+        Bloodborne::SummonBroker::ClaimStatus::Claimed);
+  retained = staleWithoutCreate.Consume(Parse(removal), 30'020);
+  CHECK(retained.retained == 1);
+  CHECK(staleWithoutCreate.Search(Parse(search), 30'109).size() == 1);
+  CHECK(staleWithoutCreate.Search(Parse(search), 30'110).isEmpty());
+  CHECK(staleWithoutCreate.Claim(Parse(conflictingClaim), conflictingClaim, 30'110).status ==
+        Bloodborne::SummonBroker::ClaimStatus::Expired);
+  const auto recoveredSign =
+      staleWithoutCreate.Advertise(Parse(advertisement), advertisement, 30'111);
+  CHECK(recoveredSign.state == Bloodborne::SummonBroker::State::Advertised);
+  CHECK(recoveredSign.expiredClaimReset);
+  CHECK(staleWithoutCreate.Claim(Parse(conflictingClaim), conflictingClaim, 30'112).status ==
+        Bloodborne::SummonBroker::ClaimStatus::Claimed);
+
+  // A normal delete may retain an in-flight claim, but it is not a heartbeat:
+  // it must not extend that record's 15-minute-style retention timer.
+  Bloodborne::SummonBroker::Options shortTtlOptions = seamlessOptions;
+  shortTtlOptions.ttlMs = 100;
+  shortTtlOptions.seamlessTtlMs = 200;
+  shortTtlOptions.seamlessClaimLeaseMs = 1'000;
+  Bloodborne::SummonBroker shortTtl(shortTtlOptions);
+  CHECK(shortTtl.Advertise(Parse(advertisement), advertisement, 40'000).state ==
+        Bloodborne::SummonBroker::State::Advertised);
+  CHECK(shortTtl.Claim(Parse(claim), claim, 40'010).status ==
+        Bloodborne::SummonBroker::ClaimStatus::Claimed);
+  CHECK(shortTtl.Consume(Parse(removal), 40'190).retained == 1);
+  CHECK(!shortTtl.StateFor(QStringLiteral("guest-session"), 2465, 40'211).has_value());
+
   Bloodborne::SummonBroker unclaimedSeamless(seamlessOptions);
   CHECK(unclaimedSeamless.Advertise(Parse(advertisement), advertisement, 7'000)
             .state == Bloodborne::SummonBroker::State::Advertised);
